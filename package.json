{
  "name": "dsh-task-delete",
  "version": "0.3.0",
  "description": "Hard-delete a Workspace task (session) from the DSH sidebar '...' menu, even while it is running.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "MaYuQiNB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaYuQiNB/dsh-task-delete.git"
  },
  "homepage": "https://github.com/MaYuQiNB/dsh-task-delete#readme",
  "bugs": {
    "url": "https://github.com/MaYuQiNB/dsh-task-delete/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "workspace",
    "session",
    "delete"
  ],
  "scripts": {
    "test": "node test/deletion.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
